<?xml version="1.0" encoding="utf-8"?>
<package>
	<metadata>
		<id>devbotas.Tools.RepositorySettings</id>
		<version>1.13.0</version>
		<title>devbotas.Tools.RepositorySettings</title>
		<authors>devbotas</authors>
		<description>Provides base repository settings files that fits devbotas style.</description>
		<copyright>© 2024-2025 Tevux Technologies</copyright>
		<license type="expression">MIT</license>
		<requireLicenseAcceptance>true</requireLicenseAcceptance>
		<repository type="git" url="https://github.com/devbotas/lib-devbotas.tools.repositorysettings" />
		<tags>csharp;editorconfig;codestyle</tags>
		<developmentDependency>true</developmentDependency>
	</metadata>
	<files>
		<file src="devbotas.Tools.RepositorySettings.props" target="build" />
		<file src=".editorconfig" target="content" />
		<file src=".gitattributes" target="content" />
		<file src=".gitignore" target="content" />
		<file src="Settings.XamlStyler" target="content" />
	</files>
</package>